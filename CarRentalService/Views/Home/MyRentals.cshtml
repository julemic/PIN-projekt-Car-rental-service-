@model List<CarRentalService.Models.RentalViewModel>
@using CarRentalService.Models

@{
    ViewData["Title"] = "My Rentals";
}

<div class="admin-page">

    <div class="admin-page-header">
        <h1 class="admin-page-title">My Rentals</h1>
        @if (Model.Any())
        {
            <span class="rh-count">@Model.Count rental@(Model.Count != 1 ? "s" : "")</span>
        }
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="admin-alert">@TempData["Msg"]</div>
    }

    @if (!Model.Any())
    {
        <div class="admin-empty">
            <p>You currently have no active rentals.</p>
        </div>
    }
    else
    {
        <div class="mr-grid">
            @foreach (var r in Model)
            {
                <div class="mr-card">

                    <!-- Header -->
                    <div class="mr-card-header">
                        <div>
                            <div class="mr-car-name">@r.Brand @r.Model</div>
                            <div class="mr-car-category">@r.Category</div>
                        </div>
                        @if (r.Status == RentalStatus.Reserved)
                        {
                            <span class="vstatus vstatus--reserved">Reserved</span>
                        }
                        else if (r.Status == RentalStatus.Returned)
                        {
                            <span class="vstatus vstatus--returned">Returned</span>
                        }
                        else if (r.Status == RentalStatus.Cancelled)
                        {
                            <span class="vstatus vstatus--cancelled">Cancelled</span>
                        }
                        else
                        {
                            <span class="vstatus vstatus--other">@r.Status</span>
                        }
                    </div>

                    <!-- Dates + Pricing -->
                    <div class="mr-card-body">
                        <div class="mr-info-block">
                            <div class="mr-info-label">Pickup</div>
                            <div class="mr-info-val">@r.Pickup.ToString("dd.MM.yyyy")</div>
                            <div class="mr-date-arrow">↓</div>
                            <div class="mr-info-label">Return</div>
                            <div class="mr-info-val">@r.Return.ToString("dd.MM.yyyy")</div>
                        </div>

                        <div class="mr-divider"></div>

                        <div class="mr-info-block">
                            <div class="mr-info-label">Duration</div>
                            <div class="mr-info-val">@r.TotalDays day@(r.TotalDays != 1 ? "s" : "")</div>
                            <div class="mr-info-label" style="margin-top:10px;">Insurance</div>
                            <div class="mr-info-val">@r.InsuranceName</div>
                            <div class="mr-info-sub">@r.InsurancePricePerDay € / day</div>
                        </div>

                        <div class="mr-divider"></div>

                        <div class="mr-info-block mr-info-block--total">
                            <div class="mr-info-label">Rate</div>
                            <div class="mr-info-val">@r.TotalPricePerDay € / day</div>
                            <div class="mr-total-label">Total paid</div>
                            <div class="mr-total-val">@r.TotalPrice €</div>
                        </div>
                    </div>

                    <!-- Payment strip -->
                    @if (r.Status == RentalStatus.Reserved)
                    {
                        <div class="mr-payment-strip">
                            <div class="mr-payment-item">
                                <span class="mr-payment-key">Deposit paid</span>
                                <span class="mr-payment-val">@r.DepositAmount €</span>
                            </div>
                            <div class="mr-payment-item">
                                <span class="mr-payment-key">Free cancel until</span>
                                <span class="mr-payment-val">
                                    @r.FreeCancellationUntil.ToString("dd.MM.yyyy")
                                    @if (r.CanFreeCancel)
                                    {
                                        <span class="mr-refund-badge mr-refund-badge--yes">Refund available</span>
                                    }
                                    else
                                    {
                                        <span class="mr-refund-badge mr-refund-badge--no">Non-refundable</span>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                    else if (r.Status == RentalStatus.Returned)
                    {
                        <div class="mr-payment-strip">
                            <div class="mr-payment-item">
                                <span class="mr-payment-key">Deposit paid</span>
                                <span class="mr-payment-val">@r.DepositAmount €</span>
                            </div>
                            <div class="mr-payment-item">
                                <span class="mr-payment-key">Payment</span>
                                <span class="mr-payment-val">Fully paid</span>
                            </div>
                        </div>
                    }
                    else if (r.Status == RentalStatus.Cancelled)
                    {
                        <div class="mr-payment-strip mr-payment-strip--muted">
                            <div class="mr-payment-item">
                                <span class="mr-payment-key">Reservation cancelled</span>
                            </div>
                        </div>
                    }

                    <!-- Actions -->
                    @if (r.Status == RentalStatus.Reserved)
                    {
                        <div class="mr-card-footer">
                            <form asp-action="ReturnCar" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rentalId" value="@r.Id" />
                                <button type="submit" class="mr-btn mr-btn--dark">Return car</button>
                            </form>
                            <form asp-action="CancelReservation" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rentalId" value="@r.Id" />
                                <button type="submit" class="mr-btn mr-btn--ghost">Cancel reservation</button>
                            </form>
                        </div>
                    }

                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/myrentals.js" asp-append-version="true"></script>
}
