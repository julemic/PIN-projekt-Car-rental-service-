@model CarRentalService.Models.AccidentReport
@using CarRentalService.Models

@{
    ViewData["Title"] = "Accident Report";
    var rentals = ViewBag.UserRentals as List<Rental> ?? new List<Rental>();
}

<div class="ar-page">

    <div class="ar-header">
        <h1 class="ar-title">Accident Report</h1>
        <p class="ar-subtitle">Fill out all required fields and submit to our team.</p>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="ar-success-msg">
            @TempData["Msg"]
        </div>
    }

    <form method="post" asp-action="CreateAccidentReport">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="ar-validation-summary"></div>

        <!-- SELECT RENTAL -->
        <div class="ar-section">
            <div class="ar-section-header">
                <span class="ar-step-badge">0</span>
                <span class="ar-section-title">Select Rental</span>
            </div>
            <div class="ar-section-body">
                <div class="ar-field">
                    <label class="ar-label">Rental</label>
                    <select asp-for="RentalId" class="ar-select" required>
                        <option value="">— Select rental —</option>
                        @foreach (var r in rentals)
                        {
                            <option value="@r.Id">
                                #@r.Id — @r.Vehicle?.Brand @r.Vehicle?.Model (@r.Pickup.ToString("dd.MM.yyyy") → @r.Return.ToString("dd.MM.yyyy"))
                            </option>
                        }
                    </select>
                    <span asp-validation-for="RentalId" class="ar-error"></span>
                </div>
            </div>
        </div>

        <!-- DRIVER INFO -->
        <div class="ar-section">
            <div class="ar-section-header">
                <span class="ar-step-badge">1</span>
                <span class="ar-section-title">Driver Information</span>
            </div>
            <div class="ar-section-body">
                <div class="ar-grid-2">
                    <div class="ar-field">
                        <label class="ar-label">Full Name</label>
                        <input asp-for="FullName" class="ar-input ar-input--readonly" readonly />
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">OIB</label>
                        <input asp-for="Oib" class="ar-input ar-input--readonly" readonly />
                        <span asp-validation-for="Oib" class="ar-error"></span>
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">Driver License Number</label>
                        <input asp-for="DriverLicenseNumber" class="ar-input ar-input--readonly" readonly />
                        <span asp-validation-for="DriverLicenseNumber" class="ar-error"></span>
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">Phone</label>
                        <input asp-for="Phone" class="ar-input ar-input--readonly" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- ACCIDENT DETAILS -->
        <div class="ar-section">
            <div class="ar-section-header">
                <span class="ar-step-badge">2</span>
                <span class="ar-section-title">Accident Details</span>
            </div>
            <div class="ar-section-body">
                <div class="ar-grid-2">
                    <div class="ar-field">
                        <label class="ar-label">Accident Date & Time</label>
                        <input asp-for="AccidentDate" type="datetime-local" class="ar-input" required />
                        <span asp-validation-for="AccidentDate" class="ar-error"></span>
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">Location</label>
                        <input asp-for="Location" class="ar-input" placeholder="City, street..." required />
                        <span asp-validation-for="Location" class="ar-error"></span>
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">Weather Conditions</label>
                        <select asp-for="Weather" class="ar-select">
                            <option>Clear</option>
                            <option>Rain</option>
                            <option>Snow</option>
                            <option>Fog</option>
                            <option>Storm</option>
                        </select>
                    </div>
                    <div class="ar-field">
                        <label class="ar-label">Road Conditions</label>
                        <select asp-for="RoadCondition" class="ar-select">
                            <option>Dry</option>
                            <option>Wet</option>
                            <option>Icy</option>
                            <option>Damaged</option>
                        </select>
                    </div>
                </div>
                <div class="ar-grid-2">
                    <div class="ar-field">
                        <label class="ar-label">Speed at Moment (km/h)</label>
                        <input asp-for="Speed" type="number" class="ar-input" placeholder="0" />
                    </div>
                </div>
                <div class="ar-checkbox-wrap">
                    <label class="ar-checkbox-label">
                        <input asp-for="PoliceNotified" class="ar-checkbox" />
                        <span class="ar-checkbox-text">Police were notified</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- DAMAGE DETAILS -->
        <div class="ar-section">
            <div class="ar-section-header">
                <span class="ar-step-badge">3</span>
                <span class="ar-section-title">Damage Details</span>
            </div>
            <div class="ar-section-body">
                <div class="ar-field" style="margin-bottom: 20px;">
                    <label class="ar-label">Damage Description</label>
                    <textarea asp-for="DamageDescription" class="ar-textarea" rows="4" placeholder="Describe the damage in detail..." required></textarea>
                    <span asp-validation-for="DamageDescription" class="ar-error"></span>
                </div>
                <div class="ar-checkbox-wrap">
                    <label class="ar-checkbox-label">
                        <input asp-for="OtherPartyInvolved" class="ar-checkbox" id="otherPartyCheck" />
                        <span class="ar-checkbox-text">Other party involved?</span>
                    </label>
                </div>
                <div id="otherPartySection" class="other-party-section ar-other-party">
                    <div class="ar-grid-2">
                        <div class="ar-field">
                            <label class="ar-label">Other Party Name</label>
                            <input asp-for="OtherPartyName" class="ar-input" />
                        </div>
                        <div class="ar-field">
                            <label class="ar-label">Other Party Vehicle Plate</label>
                            <input asp-for="OtherPartyPlate" class="ar-input" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ar-actions">
            <button type="submit"
                    class="ar-btn ar-btn--secondary"
                    formaction="@Url.Action("CreateAccidentReportPdf", "Home")">
                Save as PDF
            </button>
            <button type="submit"
                    class="ar-btn ar-btn--primary"
                    formaction="@Url.Action("CreateAccidentReport", "Home")">
                Submit Report
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/accidentreport.js" asp-append-version="true"></script>
}
