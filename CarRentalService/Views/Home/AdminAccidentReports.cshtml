@model List<CarRentalService.Models.AccidentReport>

@{
    ViewData["Title"] = "Accident Reports (Admin)";
}

<div class="admin-page">

    <div class="admin-page-header">
        <h1 class="admin-page-title">Accident Reports</h1>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty">
            <p>No accident reports submitted.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-vtable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Full Name</th>
                        <th>Accident Date</th>
                        <th>Location</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="vtable-id">@r.Id</td>
                        <td class="vtable-muted">@r.User?.UserName</td>
                        <td>
                            <div class="vtable-brand">@r.FullName</div>
                        </td>
                        <td class="vtable-muted">@r.AccidentDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="vtable-muted">@r.Location</td>
                        <td class="vtable-muted">@r.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="vtable-actions">
                            <button class="vtable-btn vtable-btn--view"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#details-@r.Id"
                                    type="button">
                                View
                            </button>

                            <form asp-action="DeleteAccidentReport"
                                  asp-controller="Home"
                                  method="post"
                                  class="d-inline delete-accident-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="vtable-btn vtable-btn--delete">Delete</button>
                            </form>
                        </td>
                    </tr>

                    <tr class="ar-detail-row collapse" id="details-@r.Id">
                        <td colspan="7" class="ar-detail-cell">
                            <div class="ar-detail-grid">

                                <div class="ar-detail-group">
                                    <div class="ar-detail-heading">Driver</div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Full name</span>
                                        <span class="ar-detail-val">@r.FullName</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">OIB</span>
                                        <span class="ar-detail-val">@r.Oib</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">License</span>
                                        <span class="ar-detail-val">@r.DriverLicenseNumber</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Phone</span>
                                        <span class="ar-detail-val">@r.Phone</span>
                                    </div>
                                </div>

                                <div class="ar-detail-group">
                                    <div class="ar-detail-heading">Conditions</div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Weather</span>
                                        <span class="ar-detail-val">@r.Weather</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Road</span>
                                        <span class="ar-detail-val">@r.RoadCondition</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Speed</span>
                                        <span class="ar-detail-val">@r.Speed km/h</span>
                                    </div>
                                    <div class="ar-detail-row-item">
                                        <span class="ar-detail-key">Police notified</span>
                                        <span class="ar-detail-val">@(r.PoliceNotified ? "Yes" : "No")</span>
                                    </div>
                                </div>

                                <div class="ar-detail-group ar-detail-group--wide">
                                    <div class="ar-detail-heading">Damage</div>
                                    <p class="ar-detail-damage">@r.DamageDescription</p>

                                    @if (!string.IsNullOrEmpty(r.OtherPartyName))
                                    {
                                        <div class="ar-detail-heading" style="margin-top: 14px;">Other Party</div>
                                        <div class="ar-detail-row-item">
                                            <span class="ar-detail-key">Name</span>
                                            <span class="ar-detail-val">@r.OtherPartyName</span>
                                        </div>
                                        <div class="ar-detail-row-item">
                                            <span class="ar-detail-key">Plate</span>
                                            <span class="ar-detail-val">@r.OtherPartyPlate</span>
                                        </div>
                                    }
                                </div>

                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/admin-accidents.js" asp-append-version="true"></script>
}
