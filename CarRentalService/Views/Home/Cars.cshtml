@model CarRentalService.Models.CarsViewModel
@using CarRentalService.Models

@{
    ViewData["Title"] = "Cars";
}

<div class="cars-page">

    <form asp-action="Cars" asp-controller="Home" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3"></div>
        }

        <div class="search-panel">
            <div class="search-field">
                <label asp-for="Search.Pickup" class="search-label">Pickup Date</label>
                <div class="date-display-wrap" onclick="document.getElementById('pickup-input').showPicker()">
                    <svg class="date-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                    </svg>
                    <span class="date-display-text" id="pickup-text">Day of Pick Up</span>
                    <input asp-for="Search.Pickup" type="date" id="pickup-input" class="date-overlay-input" />
                </div>
                <span asp-validation-for="Search.Pickup" class="search-error"></span>
            </div>
            <div class="search-divider"></div>
            <div class="search-field">
                <label asp-for="Search.Return" class="search-label">Return Date</label>
                <div class="date-display-wrap" onclick="document.getElementById('return-input').showPicker()">
                    <svg class="date-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                    </svg>
                    <span class="date-display-text" id="return-text">Day of Return</span>
                    <input asp-for="Search.Return" type="date" id="return-input" class="date-overlay-input" />
                </div>
                <span asp-validation-for="Search.Return" class="search-error"></span>
            </div>
            <div class="search-action">
                <button type="submit" class="search-action-btn">
                    <i class='bx bx-search-alt-2'></i> Search
                </button>
            </div>
        </div>

        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-success rounded-3 mb-4">@TempData["Msg"]</div>
        }

        @if (Model.ShowVehicles)
        {
            <div class="insurance-section">
                <p class="cars-section-title">Choose Protection Plan</p>

                <div class="insurance-grid">

                    <div class="insurance-option">
                        <input class="insurance-radio"
                               asp-for="Search.SelectedInsurancePlan"
                               type="radio"
                               value="Basic"
                               id="basicPlan" />
                        <label class="insurance-label" for="basicPlan">
                            <div class="insurance-check-mark">&#10003;</div>
                            <div class="insurance-top">
                                <div class="insurance-plan-name">BASIC</div>
                                <div class="insurance-plan-sub">protect</div>
                                <div class="insurance-plan-price">Free</div>
                            </div>
                            <ul class="insurance-feats">
                                <li class="yes">Basic liability coverage</li>
                                <li class="yes">Mandatory insurance included</li>
                                <li class="no">No damage reduction</li>
                            </ul>
                        </label>
                    </div>

                    <div class="insurance-option">
                        <input class="insurance-radio"
                               asp-for="Search.SelectedInsurancePlan"
                               type="radio"
                               value="Medium"
                               id="mediumPlan" />
                        <label class="insurance-label" for="mediumPlan">
                            <div class="insurance-check-mark">&#10003;</div>
                            <div class="insurance-top">
                                <div class="insurance-plan-name">MEDIUM</div>
                                <div class="insurance-plan-sub">protect</div>
                                <div class="insurance-plan-price">17€ <span class="price-per-day">/day</span></div>
                            </div>
                            <ul class="insurance-feats">
                                <li class="yes">Reduced damage liability</li>
                                <li class="yes">Passenger insurance</li>
                                <li class="yes">Partial theft protection</li>
                            </ul>
                        </label>
                    </div>

                    <div class="insurance-option">
                        <input class="insurance-radio"
                               asp-for="Search.SelectedInsurancePlan"
                               type="radio"
                               value="Total"
                               id="totalPlan" />
                        <label class="insurance-label" for="totalPlan">
                            <div class="insurance-check-mark">&#10003;</div>
                            <div class="insurance-top">
                                <div class="insurance-plan-name">TOTAL</div>
                                <div class="insurance-plan-sub">protect</div>
                                <div class="insurance-plan-price">22€ <span class="price-per-day">/day</span></div>
                            </div>
                            <ul class="insurance-feats">
                                <li class="yes">Full damage coverage</li>
                                <li class="yes">Full theft protection</li>
                                <li class="yes">No excess / no hidden costs</li>
                            </ul>
                        </label>
                    </div>

                </div>

                <span asp-validation-for="Search.SelectedInsurancePlan" class="search-error d-block mt-2"></span>
            </div>

            <div class="cars-filters-bar">
                <div class="category-pills-wrap">
                    <button type="submit" name="Category" value="All offers" class="cat-pill">
                        All offers
                    </button>
                    @foreach (var c in Model.Categories.Where(x => x != "All offers"))
                    {
                        <button type="submit" name="Category" value="@c" class="cat-pill">
                            @c
                        </button>
                    }
                </div>
                <div>
                    <select name="Sort" onchange="this.form.submit()" class="cars-sort-select">
                        <option value="">Sort by price</option>
                        <option value="price_asc" selected="@(Model.Sort == "price_asc")">Lowest first</option>
                        <option value="price_desc" selected="@(Model.Sort == "price_desc")">Highest first</option>
                    </select>
                </div>
            </div>

            @if (!Model.Vehicles.Any())
            {
                <div class="cars-empty-state">
                    <i class='bx bx-car'></i>
                    <p>No vehicles available for selected dates.</p>
                </div>
            }
            else
            {
                <div class="vehicles-grid">
                    @foreach (var item in Model.Vehicles)
                    {
                        <div class="vcard @(item.Available <= 0 ? "vcard--unavailable" : "")">
                            <div class="vcard-img-wrap">
                                <img src="@(item.Vehicle.ImageUrl?.StartsWith("/") == true ? item.Vehicle.ImageUrl : $"/images/{item.Vehicle.ImageUrl}")"
                                     alt="@item.Vehicle.Brand @item.Vehicle.Model" />
                                @if (!string.IsNullOrEmpty(item.Vehicle.Category))
                                {
                                    <span class="vcard-cat-badge">@item.Vehicle.Category</span>
                                }
                                @if (item.Available <= 0)
                                {
                                    <div class="vcard-unavail-overlay">
                                        <span>Unavailable</span>
                                    </div>
                                }
                            </div>
                            <div class="vcard-body">
                                <div class="vcard-name-price">
                                    <div>
                                        <div class="vcard-brand">@item.Vehicle.Brand</div>
                                        <div class="vcard-model">@item.Vehicle.Model</div>
                                    </div>
                                    <div class="vcard-price-block">
                                        <div class="vcard-price-num">@item.Vehicle.DailyPrice€</div>
                                        <span class="vcard-price-unit">per day</span>
                                    </div>
                                </div>
                                <div class="vcard-avail @(item.Available > 0 ? "vcard-avail--ok" : "vcard-avail--none")">
                                    <span class="vcard-avail-dot"></span>
                                    @(item.Available > 0 ? $"{item.Available} available" : "Not available")
                                </div>
                                @if (item.Available > 0)
                                {
                                    <button type="submit"
                                            name="VehicleId"
                                            value="@item.Vehicle.Id"
                                            formaction="@Url.Action("Rent", "Home")"
                                            class="vcard-rent-btn vcard-rent-btn--active">
                                        RENT NOW
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="vcard-rent-btn vcard-rent-btn--disabled" disabled>
                                        NOT AVAILABLE
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cars.js" asp-append-version="true"></script>
}
