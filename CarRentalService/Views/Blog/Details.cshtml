@model CarRentalService.Models.BlogPost
@inject Ganss.Xss.HtmlSanitizer HtmlSanitizer

@{
    ViewData["Title"] = Model.Title;
}

<div class="blog-detail">

    <a asp-action="Index" class="blog-detail-back">
        <i class='bx bx-left-arrow-alt'></i> Back to Blog
    </a>

    <h1 class="blog-detail-title">@Model.Title</h1>

    <div class="blog-detail-meta">
        <i class='bx bx-calendar-alt' style="color:#ff3c00"></i>
        @Model.CreatedAt.ToString("dd.MM.yyyy")
        @if (Model.UpdatedAt.HasValue)
        {
            <span class="blog-detail-meta-dot">·</span>
            <span>Updated @Model.UpdatedAt.Value.ToString("dd.MM.yyyy")</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" alt="@Model.Title" class="blog-detail-hero" />
    }

    <div class="blog-detail-content">
        @Html.Raw(HtmlSanitizer.Sanitize(Model.Content ?? ""))
    </div>

</div>
