@model List<CarRentalService.Models.BlogPost>
@using CarRentalService.Models

@{
    ViewData["Title"] = "Blog";
}

<div class="blog-page">

    <div class="blog-page-header">
        <h1 class="blog-page-title">Blog</h1>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="blog-new-btn">
                <i class='bx bx-plus'></i> New Post
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="blog-empty">
            <i class='bx bx-news'></i>
            <p>No blog posts yet.</p>
        </div>
    }
    else
    {
        <div class="blog-grid">
            @foreach (var post in Model)
            {
                <div class="bcard">

                    <div class="bcard-image">
                        @if (!string.IsNullOrEmpty(post.ImagePath))
                        {
                            <img src="@post.ImagePath" alt="@post.Title" />
                        }
                        else
                        {
                            <div class="bcard-image-placeholder">
                                <i class='bx bx-image-alt'></i>
                            </div>
                        }
                    </div>

                    <div class="bcard-body">
                        <div class="bcard-date">@post.CreatedAt.ToString("dd.MM.yyyy")</div>
                        <div class="bcard-title">@post.Title</div>

                        @if (!string.IsNullOrEmpty(post.ShortDescription))
                        {
                            <p class="bcard-desc">@post.ShortDescription</p>
                        }

                        <div class="bcard-footer">
                            <a asp-action="Details" asp-route-id="@post.Id" class="bcard-read-link">
                                Read more <i class='bx bx-right-arrow-alt'></i>
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="bcard-admin-actions">
                                    <a asp-action="Edit" asp-route-id="@post.Id" class="bcard-admin-btn bcard-admin-btn--edit">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="d-inline delete-blog-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="bcard-admin-btn bcard-admin-btn--delete">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/blog-list.js" asp-append-version="true"></script>
}
